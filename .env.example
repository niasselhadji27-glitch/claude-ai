# --- Meta (Facebook/Instagram) Marketing API ---
# Create an app at https://developers.facebook.com, add the Marketing API,
# and generate a token with ads_read permission.
META_ACCESS_TOKEN=
# Your ad account id WITHOUT the "act_" prefix, e.g. 1234567890
META_AD_ACCOUNT_ID=
# Graph API version
META_API_VERSION=v21.0

# --- Anthropic (AI ad copy + creative concepts) ---
ANTHROPIC_API_KEY=

# --- Replicate (AI image + video generation) ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Model slugs are configurable — swap for any text-to-image / text-to-video
# model on Replicate that takes a "prompt" input.
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01

PORT=3000
